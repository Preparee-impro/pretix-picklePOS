#: pretix_picklePOS/static/pretix_picklePOS/frontdesk.js
msgid ""
"Are you sure you want to completely cancel this order? This action cannot be "
"undone."
msgstr ""
"Ben je zeker dat je deze bestelling wil annuleren? Deze actie kan niet "
"ongedaan gemaakt worden."

#: pretix_picklePOS/static/pretix_picklePOS/frontdesk.js
msgid "Canceling..."
msgstr "Annuleren..."

#: pretix_picklePOS/static/pretix_picklePOS/frontdesk.js
msgid "Order successfully canceled."
msgstr "Bestelling geannuleerd"

#: pretix_picklePOS/static/pretix_picklePOS/frontdesk.js
msgid "Error canceling order."
msgstr "Probleem bij het annuleren van bestelling"

#: pretix_picklePOS/static/pretix_picklePOS/frontdesk.js
msgid "Cancel Order"
msgstr "Bestelling Annuleren"
