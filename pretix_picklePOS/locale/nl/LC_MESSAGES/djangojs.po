#: pretix_picklePOS/static/pretix_picklePOS/frontdesk.js
#, javascript-format
msgid "(Pay +%s)"
msgstr "(+%s te betalen)"

#: pretix_picklePOS/static/pretix_picklePOS/frontdesk.js
#, javascript-format
msgid "(Refund %s)"
msgstr "(%s terugbetalen)"

#: pretix_picklePOS/static/pretix_picklePOS/frontdesk.js
#, javascript-format
msgid "Update Order %s"
msgstr "Bestelling aanpassen %s"

#: pretix_picklePOS/static/pretix_picklePOS/frontdesk.js
msgid "Checkout (Cash)"
msgstr "Betaald (Cash)"

#: pretix_picklePOS/static/pretix_picklePOS/frontdesk.js
msgid "Processing..."
msgstr "Verwerken..."

#: pretix_picklePOS/static/pretix_picklePOS/frontdesk.js
msgid "Error submitting order."
msgstr "Probleem bij het plaatsen van bestelling"

#: pretix_picklePOS/static/pretix_picklePOS/frontdesk.js
msgid "Please enter at least 2 characters to search."
msgstr "Typ tenminste 2 letters om te zoeken."

#: pretix_picklePOS/static/pretix_picklePOS/frontdesk.js
msgid "No active orders found matching your search."
msgstr "Zoekopdracht heeft geen actieve bestellingen gevonden."

#: pretix_picklePOS/static/pretix_picklePOS/frontdesk.js
msgid "No name or email"
msgstr "Geen naam of e-mail"

#: pretix_picklePOS/static/pretix_picklePOS/frontdesk.js
msgid "Error searching for orders."
msgstr "Probleem bij het laden van bestelling"

#: pretix_picklePOS/static/pretix_picklePOS/frontdesk.js
msgid "Error loading order details."
